{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execSync('npx prisma generate',{stdio:'inherit'})}catch(e){console.log('Prisma generate bypassed')}\"",
    "dev": "next dev -p 3001",
    "build": "node -e \"try{require('child_process').execSync('npx prisma generate',{stdio:'inherit'})}catch(e){console.log('Prisma generate bypassed')}\" && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "build:analyze": "@next/bundle-analyzer"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "animate.css": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.12",
    "jose": "^6.2.4",
    "next": "16.2.10",
    "papaparse": "^5.5.4",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "wowjs": "^1.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.29.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4",
    "@tailwindcss/oxide-linux-x64-musl": "^4",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-linux-x64-musl": "^1.29.1"
  }
}
